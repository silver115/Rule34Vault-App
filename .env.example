# App secrets
PUSH_SERVER_URL=https://your-push-server.example.com
REC_SERVER_URL=https://your-rec-server.example.com

# Push server secrets
PUSH_ENCRYPTION_KEY=your-64-char-hex-encryption-key-here
PUSH_SERVER_PORT=4829
PUSH_POLL_INTERVAL=300000

# Recommendation server config
REC_SERVER_PORT=4830
R34_API_BASE=https://rule34vault.com
MAX_SEEN=5000
DECAY_LAMBDA=0.03
DIVERSITY_ARTIST_CAP=3
DIVERSITY_CHAR_CAP=5
BANDIT_PRIOR_ALPHA=1
BANDIT_PRIOR_BETA=10
# Seen post suppression
SEEN_SUPPRESSION_DAYS=30
# Profile refresh schedule
INCREMENTAL_TTL=300000
FULL_REBUILD_TTL=86400000
# History fetch depth (pages x50 posts each; 100=up to 5000 posts per type)
MAX_HISTORY_PAGES=100

# Admin UI protection (leave blank = no auth required, local use only)
ADMIN_TOKEN=

# Cloudflare tunnels
CLOUDFLARE_TUNNEL_TOKEN=your-push-server-tunnel-token-here
REC_CLOUDFLARE_TUNNEL_TOKEN=your-rec-server-tunnel-token-here
