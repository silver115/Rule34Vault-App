# App secrets
PUSH_SERVER_URL=https://your-push-server.example.com

# Push server secrets
PUSH_ENCRYPTION_KEY=your-64-char-hex-encryption-key-here
PUSH_SERVER_PORT=4829
PUSH_POLL_INTERVAL=300000

# Cloudflare tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token-here

# EAS / Expo
EAS_PROJECT_ID=your-eas-project-id-here
EXPO_OWNER=your-expo-username
ANDROID_PACKAGE=com.yourname.rule34vaultapp
